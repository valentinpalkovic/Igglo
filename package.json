{
  "name": "igglo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise \"packages/*/src\" apps fixtures --config .dependency-cruiser.cjs",
    "workflow-pins": "node scripts/check-workflow-pins.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm depcruise"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
